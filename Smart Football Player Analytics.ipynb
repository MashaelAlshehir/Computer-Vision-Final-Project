import os
import cv2
import numpy as np
import supervision as sv
from ultralytics import YOLO
from google.colab import drive
from IPython.display import Video, display

import subprocess
from IPython.display import Video, display

def convert_and_display(input_path, output_path):
    subprocess.run([
        "ffmpeg",
        "-y",
        "-i", input_path,
        "-c:v", "libx264",
        "-pix_fmt", "yuv420p",
        "-movflags", "+faststart",
        "-an",
        output_path
    ], check=True)

    display(Video(
        output_path,
        embed=True,
        width=640,
        height=360
    ))
# ------------------------------------------------------------
# 1. Google Drive
# ------------------------------------------------------------

if not os.path.exists("/content/drive"):
    drive.mount("/content/drive")

video_path = "/content/drive/MyDrive/shot1.mp4"

assert os.path.exists(video_path), f"Video not found: {video_path}"

# ------------------------------------------------------------
# 2. Video information
# ------------------------------------------------------------

video_info = sv.VideoInfo.from_video_path(video_path)

W = video_info.width
H = video_info.height
FPS = video_info.fps

print(f"Video: {W}x{H}")
print(f"FPS: {FPS}")
print(f"Frames: {video_info.total_frames}")

# ------------------------------------------------------------
# 3. Model
# ------------------------------------------------------------

model = YOLO("yolov8m.pt")

# ------------------------------------------------------------
# 4. Tracker
# ------------------------------------------------------------

tracker = sv.ByteTrack()

box_annotator = sv.BoxAnnotator(thickness=3)
label_annotator = sv.LabelAnnotator(
    text_scale=0.6,
    text_padding=4
)

# ------------------------------------------------------------
# 5. Store tracking information
# ------------------------------------------------------------

tracking_data = []

unique_ids = set()

output_task1 = "task1_player_tracking.mp4"

# ------------------------------------------------------------
# 6. Process video
# ------------------------------------------------------------

print("Running Player Detection & Tracking...")

with sv.VideoSink(
    target_path=output_task1,
    video_info=video_info
) as sink:

    for frame_idx, frame in enumerate(
        sv.get_video_frames_generator(video_path)
    ):

        # Detect persons
        result = model.predict(
            frame,
            classes=[0],       # person
            conf=0.35,
            iou=0.50,
            verbose=False
        )[0]

        detections = sv.Detections.from_ultralytics(result)

        # ----------------------------------------------------
        # Filter unrealistic detections
        # ----------------------------------------------------

        if len(detections) > 0:

            widths = detections.xyxy[:, 2] - detections.xyxy[:, 0]
            heights = detections.xyxy[:, 3] - detections.xyxy[:, 1]

            valid = (
                (heights > 30) &
                (widths > 15) &
                (heights < H * 0.45)
            )

            detections = detections[valid]

        # ----------------------------------------------------
        # Tracking
        # ----------------------------------------------------

        detections = tracker.update_with_detections(detections)

        frame_data = []

        if (
            len(detections) > 0
            and detections.tracker_id is not None
        ):

            for bbox, track_id in zip(
                detections.xyxy,
                detections.tracker_id
            ):

                x1, y1, x2, y2 = map(int, bbox)

                cx = int((x1 + x2) / 2)
                cy = int((y1 + y2) / 2)

                unique_ids.add(int(track_id))

                frame_data.append({
                    "id": int(track_id),
                    "bbox": (x1, y1, x2, y2),
                    "center": (cx, cy)
                })

        tracking_data.append(frame_data)

        # ----------------------------------------------------
        # Draw
        # ----------------------------------------------------

        annotated = frame.copy()

        if len(detections) > 0:

            labels = [
                f"Player {tid}"
                for tid in detections.tracker_id
            ]

            annotated = box_annotator.annotate(
                scene=annotated,
                detections=detections
            )

            annotated = label_annotator.annotate(
                scene=annotated,
                detections=detections,
                labels=labels
            )

        cv2.putText(
            annotated,
            f"Players: {len(detections)}",
            (30, 50),
            cv2.FONT_HERSHEY_SIMPLEX,
            1.0,
            (0, 255, 255),
            2
        )

        sink.write_frame(annotated)

print("Task 1 completed.")
print(f"Unique tracked players: {len(unique_ids)}")

task1_fixed = "task1_player_tracking_fixed.mp4"
convert_and_display(output_task1, task1_fixed)

"""## Task 2: Team Classification

This task classifies the detected football players into two teams based on the dominant color of their shirts. The tracking information generated in Task 1 is reused to locate each player across the video frames.
"""

# ============================================================
# TASK 2 — TEAM CLASSIFICATION
# ============================================================
import subprocess
from IPython.display import Video, display
def convert_and_display(input_path, output_path):
    subprocess.run([
        "ffmpeg",
        "-y",
        "-i", input_path,
        "-c:v", "libx264",
        "-pix_fmt", "yuv420p",
        "-movflags", "+faststart",
        "-an",
        output_path
    ], check=True)

    display(Video(
        output_path,
        embed=True,
        width=640,
        height=360
    ))

    display(Video(output_path, embed=True))
def classify_team(frame, bbox):

    x1, y1, x2, y2 = bbox

    x1 = max(0, x1)
    y1 = max(0, y1)
    x2 = min(W, x2)
    y2 = min(H, y2)

    crop = frame[y1:y2, x1:x2]

    if crop.size == 0:
        return "Unknown"

    h, w = crop.shape[:2]

    # Shirt region
    shirt = crop[
        int(h * 0.15):int(h * 0.60),
        int(w * 0.20):int(w * 0.80)
    ]

    if shirt.size == 0:
        return "Unknown"

    hsv = cv2.cvtColor(shirt, cv2.COLOR_BGR2HSV)

    # Ignore very dark pixels
    saturation = hsv[:, :, 1]
    value = hsv[:, :, 2]

    valid = (
        (value > 45) &
        (saturation > 35)
    )

    if np.sum(valid) < 30:
        return "Unknown"

    hue_values = hsv[:, :, 0][valid]

    # Red detection
    red_mask = (
        (hue_values < 10) |
        (hue_values > 170)
    )

    red_ratio = np.mean(red_mask)

    # White detection
    white_mask = (
        (saturation < 55) &
        (value > 150)
    )

    white_ratio = np.mean(white_mask)

    if red_ratio > 0.25:
        return "Team A"

    if white_ratio > 0.30:
        return "Team B"

    return "Unknown"


# ------------------------------------------------------------
# Generate Team Classification Video
# ------------------------------------------------------------

output_task2 = "task2_team_classification.mp4"

print("Running Team Classification...")

with sv.VideoSink(
    target_path=output_task2,
    video_info=video_info
) as sink:

    frame_generator = sv.get_video_frames_generator(video_path)

    for frame_idx, frame in enumerate(frame_generator):

        annotated = frame.copy()

        detections_frame = tracking_data[frame_idx]

        for player in detections_frame:

            track_id = player["id"]
            bbox = player["bbox"]

            team = classify_team(
                frame,
                bbox
            )

            x1, y1, x2, y2 = bbox

            # Draw box
            cv2.rectangle(
                annotated,
                (x1, y1),
                (x2, y2),
                (0, 255, 0),
                2
            )

            # Label
            cv2.putText(
                annotated,
                f"ID:{track_id} {team}",
                (x1, max(30, y1 - 10)),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.6,
                (255, 255, 255),
                2
            )

        sink.write_frame(annotated)

print("Task 2 completed.")

task2_fixed = "task2_team_classification_fixed.mp4"
convert_and_display(output_task2, task2_fixed)

"""## Task 3: Player Movement Heatmap

This task generates a heatmap that visualizes the areas most frequently occupied by players throughout the video. The center positions collected during player tracking are accumulated to identify high-activity and low-activity regions on the field.
"""

# ============================================================
# TASK 3 — PLAYER HEATMAP
# ============================================================
import subprocess
from IPython.display import Video, display
def convert_and_display(input_path, output_path):
    subprocess.run([
        "ffmpeg",
        "-y",
        "-i", input_path,
        "-c:v", "libx264",
        "-pix_fmt", "yuv420p",
        "-movflags", "+faststart",
        "-an",
        output_path
    ], check=True)

    display(Video(
        output_path,
        embed=True,
        width=640,
        height=360
    ))
# ------------------------------------------------------------
# Accumulate player positions
# ------------------------------------------------------------

for frame_data in tracking_data:

    for player in frame_data:

        cx, cy = player["center"]

        if 0 <= cx < W and 0 <= cy < H:

            cv2.circle(
                heatmap,
                (cx, cy),
                25,
                1.0,
                -1
            )

# ------------------------------------------------------------
# Blur
# ------------------------------------------------------------

heatmap = cv2.GaussianBlur(
    heatmap,
    (0, 0),
    sigmaX=35,
    sigmaY=35
)

# Normalize
if heatmap.max() > 0:
    heatmap = heatmap / heatmap.max()

output_task3 = "task3_heatmap.mp4"

print("Generating Heatmap video...")

with sv.VideoSink(
    target_path=output_task3,
    video_info=video_info
) as sink:

    for frame in sv.get_video_frames_generator(video_path):

        normalized = (
            heatmap * 255
        ).astype(np.uint8)

        colored = cv2.applyColorMap(
            normalized,
            cv2.COLORMAP_JET
        )

        # Make heatmap transparent
        output = cv2.addWeighted(
            frame,
            0.65,
            colored,
            0.35,
            0
        )

        cv2.putText(
            output,
            "PLAYER MOVEMENT HEATMAP",
            (30, 50),
            cv2.FONT_HERSHEY_SIMPLEX,
            1,
            (255, 255, 255),
            2
        )

        sink.write_frame(output)

print("Task 3 completed.")

task3_fixed = "task3_heatmap_fixed.mp4"
convert_and_display(output_task3, task3_fixed)

"""### 4. Tactical Zone Visualization

The football field is divided into three vertical tactical zones: defense, midfield, and attack. Two boundary lines are drawn to separate these zones. Each player is assigned to a zone based on the horizontal position of the center of their bounding box.
"""

# ============================================================
# TASK 4 — MOVEMENT TRAILS + TACTICAL ZONES
# ============================================================

from collections import defaultdict, deque
import subprocess
from IPython.display import Video, display


# ------------------------------------------------------------
# Convert and display video
# ------------------------------------------------------------

def convert_and_display(input_path, output_path):
    subprocess.run([
        "ffmpeg",
        "-y",
        "-i", input_path,
        "-c:v", "libx264",
        "-pix_fmt", "yuv420p",
        "-movflags", "+faststart",
        "-an",
        output_path
    ], check=True)

    display(Video(
        output_path,
        embed=True,
        width=640,
        height=360
    ))


# ------------------------------------------------------------
# Store the last 40 positions of each player
# ------------------------------------------------------------

trails = defaultdict(
    lambda: deque(maxlen=40)
)


# Divide the field into three equal vertical zones
zone_w = W // 3

output_task4 = "task4_trails_zones.mp4"

print("Generating Movement Trails + Tactical Zones...")


# ------------------------------------------------------------
# Process video
# ------------------------------------------------------------

with sv.VideoSink(
    target_path=output_task4,
    video_info=video_info
) as sink:

    for frame_idx, frame in enumerate(
        sv.get_video_frames_generator(video_path)
    ):

        annotated = frame.copy()

        # Get tracking results for the current frame
        detections_frame = tracking_data[frame_idx]

        zone_counts = {
            "DEFENSE": 0,
            "MIDFIELD": 0,
            "ATTACK": 0
        }


        # ----------------------------------------------------
        # Process tracked players
        # ----------------------------------------------------

        for player in detections_frame:

            track_id = player["id"]

            x1, y1, x2, y2 = player["bbox"]
            cx, cy = player["center"]

            # Save the current player position
            trails[track_id].append((cx, cy))


            # ------------------------------------------------
            # Determine the player's tactical zone
            # ------------------------------------------------

            if cx < zone_w:
                zone = "DEFENSE"

            elif cx < zone_w * 2:
                zone = "MIDFIELD"

            else:
                zone = "ATTACK"

            zone_counts[zone] += 1


            # ------------------------------------------------
            # Draw player bounding box and ID
            # ------------------------------------------------

            cv2.rectangle(
                annotated,
                (x1, y1),
                (x2, y2),
                (0, 255, 0),
                2
            )

            cv2.putText(
                annotated,
                f"ID:{track_id}",
                (x1, max(25, y1 - 5)),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.55,
                (255, 255, 255),
                2
            )


            # ------------------------------------------------
            # Draw movement trail
            # ------------------------------------------------

            points = list(trails[track_id])

            for i in range(1, len(points)):

                cv2.line(
                    annotated,
                    points[i - 1],
                    points[i],
                    (0, 200, 255),
                    3
                )


        # ----------------------------------------------------
        # Draw tactical zone boundaries
        # ----------------------------------------------------

        cv2.line(
            annotated,
            (zone_w, 0),
            (zone_w, H),
            (255, 255, 0),
            3
        )

        cv2.line(
            annotated,
            (zone_w * 2, 0),
            (zone_w * 2, H),
            (255, 255, 0),
            3
        )


        # ----------------------------------------------------
        # Display player count in each zone
        # ----------------------------------------------------

        cv2.putText(
            annotated,
            f"DEFENSE: {zone_counts['DEFENSE']}",
            (30, H - 70),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.8,
            (255, 255, 255),
            2
        )

        cv2.putText(
            annotated,
            f"MIDFIELD: {zone_counts['MIDFIELD']}",
            (zone_w + 30, H - 70),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.8,
            (255, 255, 255),
            2
        )

        cv2.putText(
            annotated,
            f"ATTACK: {zone_counts['ATTACK']}",
            (zone_w * 2 + 30, H - 70),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.8,
            (255, 255, 255),
            2
        )


        # Write the annotated frame
        sink.write_frame(annotated)


# ------------------------------------------------------------
# Convert and display output
# ------------------------------------------------------------

print("Task 4 completed.")

task4_fixed = "task4_trails_zones_fixed.mp4"

convert_and_display(
    output_task4,
    task4_fixed
)

"""### 5. Crowding Detection

The center positions of all tracked players are collected for each frame. Pairwise distances are then calculated to detect whether at least four players are located close to one another. A continuous crowding situation is counted as one event until the players separate and a new crowding event occurs.
"""

# ============================================================
# TASK 5 — CROWDING DETECTION
# ============================================================

import subprocess
import numpy as np
from scipy.spatial.distance import cdist
from IPython.display import Video, display


# ------------------------------------------------------------
# Convert and display video
# ------------------------------------------------------------

def convert_and_display(input_path, output_path):
    subprocess.run([
        "ffmpeg",
        "-y",
        "-i", input_path,
        "-c:v", "libx264",
        "-pix_fmt", "yuv420p",
        "-movflags", "+faststart",
        "-an",
        output_path
    ], check=True)

    display(Video(
        output_path,
        embed=True,
        width=640,
        height=360
    ))


# ------------------------------------------------------------
# Crowding settings
# ------------------------------------------------------------

output_task5 = "task5_crowding.mp4"

# Maximum distance between nearby players
CROWD_DISTANCE = min(W, H) * 0.12

# Minimum number of players required for crowding
MIN_PLAYERS = 4

total_crowd_events = 0
crowd_active = False

print("Generating Crowding Detection video...")


# ------------------------------------------------------------
# Process video
# ------------------------------------------------------------

with sv.VideoSink(
    target_path=output_task5,
    video_info=video_info
) as sink:

    for frame_idx, frame in enumerate(
        sv.get_video_frames_generator(video_path)
    ):

        annotated = frame.copy()

        # Retrieve tracking results for the current frame
        detections_frame = tracking_data[frame_idx]

        centers = [
            player["center"]
            for player in detections_frame
        ]

        crowded = False


        # ----------------------------------------------------
        # Calculate distances between players
        # ----------------------------------------------------

        if len(centers) >= MIN_PLAYERS:

            points = np.array(centers)

            distances = cdist(
                points,
                points
            )

            # Count nearby players for each player
            nearby_counts = np.sum(
                distances < CROWD_DISTANCE,
                axis=1
            ) - 1

            # Crowding occurs when at least four players
            # are located close to each other
            if np.max(nearby_counts) >= MIN_PLAYERS - 1:
                crowded = True


        # ----------------------------------------------------
        # Count separate crowding events
        # ----------------------------------------------------

        if crowded and not crowd_active:

            total_crowd_events += 1
            crowd_active = True

        elif not crowded:

            crowd_active = False


        # ----------------------------------------------------
        # Draw player bounding boxes
        # ----------------------------------------------------

        for player in detections_frame:

            x1, y1, x2, y2 = player["bbox"]

            box_color = (
                (0, 0, 255)
                if crowded
                else (0, 255, 0)
            )

            cv2.rectangle(
                annotated,
                (x1, y1),
                (x2, y2),
                box_color,
                2
            )


        # ----------------------------------------------------
        # Create dashboard
        # ----------------------------------------------------

        overlay = annotated.copy()

        cv2.rectangle(
            overlay,
            (20, 20),
            (500, 140),
            (0, 0, 0),
            -1
        )

        annotated = cv2.addWeighted(
            overlay,
            0.65,
            annotated,
            0.35,
            0
        )

        cv2.putText(
            annotated,
            "SMART FOOTBALL ANALYTICS",
            (35, 55),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.8,
            (255, 255, 255),
            2
        )

        cv2.putText(
            annotated,
            f"Active Players: {len(detections_frame)}",
            (35, 85),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.6,
            (255, 255, 255),
            2
        )


        # ----------------------------------------------------
        # Display crowding status
        # ----------------------------------------------------

        if crowded:

            cv2.putText(
                annotated,
                "TACTICAL ALERT: CROWDING",
                (35, 120),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.65,
                (0, 0, 255),
                2
            )

        else:

            cv2.putText(
                annotated,
                "STATUS: NORMAL",
                (35, 120),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.65,
                (0, 255, 0),
                2
            )

        sink.write_frame(annotated)


# ------------------------------------------------------------
# Convert and display output
# ------------------------------------------------------------

print("Task 5 completed.")
print("Total crowd events:", total_crowd_events)

task5_fixed = "task5_crowding_fixed.mp4"

convert_and_display(
    output_task5,
    task5_fixed
)

"""## Final Integrated Smart Football Analytics System

This section combines all previous tasks into one complete system, including player detection and tracking, team classification, movement heatmaps, movement trails, tactical zones, and crowding detection.
"""

# ============================================================
# FINAL — INTEGRATED SMART FOOTBALL ANALYTICS
# ============================================================

import cv2
import numpy as np
import subprocess
import supervision as sv

from collections import defaultdict, deque
from scipy.spatial.distance import cdist
from IPython.display import Video, display


# ------------------------------------------------------------
# Convert and display video
# ------------------------------------------------------------

def convert_and_display(input_path, output_path):

    subprocess.run([
        "ffmpeg",
        "-y",
        "-i", input_path,
        "-c:v", "libx264",
        "-pix_fmt", "yuv420p",
        "-movflags", "+faststart",
        "-an",
        output_path
    ], check=True)

    display(Video(
        output_path,
        embed=True,
        width=640,
        height=360
    ))


# ------------------------------------------------------------
# Output settings
# ------------------------------------------------------------

output_final = "smart_football_final.mp4"
final_fixed = "smart_football_final_fixed.mp4"


# ------------------------------------------------------------
# Tactical zone settings
# ------------------------------------------------------------

zone_w = W // 3


# ------------------------------------------------------------
# Crowding settings
# ------------------------------------------------------------

CROWD_DISTANCE = min(W, H) * 0.12
MIN_PLAYERS = 4

crowd_active = False
total_events = 0


# ------------------------------------------------------------
# Store recent movement positions
# ------------------------------------------------------------

final_trails = defaultdict(
    lambda: deque(maxlen=40)
)


print("Generating final integrated video...")


# ============================================================
# PROCESS VIDEO
# ============================================================

with sv.VideoSink(
    target_path=output_final,
    video_info=video_info
) as sink:

    for frame_idx, frame in enumerate(
        sv.get_video_frames_generator(video_path)
    ):

        annotated = frame.copy()

        # Retrieve tracking data for the current frame
        detections_frame = tracking_data[frame_idx]


        # ====================================================
        # 1. HEATMAP
        # ====================================================

        normalized_heatmap = (
            heatmap * 255
        ).astype(np.uint8)

        heat_color = cv2.applyColorMap(
            normalized_heatmap,
            cv2.COLORMAP_JET
        )

        annotated = cv2.addWeighted(
            annotated,
            0.75,
            heat_color,
            0.25,
            0
        )


        # ====================================================
        # 2. TACTICAL ZONES
        # ====================================================

        zone_counts = {
            "DEFENSE": 0,
            "MIDFIELD": 0,
            "ATTACK": 0
        }

        centers = []


        # ====================================================
        # 3. PLAYER ANALYSIS
        # ====================================================

        for player in detections_frame:

            track_id = player["id"]

            x1, y1, x2, y2 = player["bbox"]
            cx, cy = player["center"]

            centers.append((cx, cy))


            # ------------------------------------------------
            # Team classification
            # ------------------------------------------------

            team = classify_team(
                frame,
                (x1, y1, x2, y2)
            )


            # ------------------------------------------------
            # Determine tactical zone
            # ------------------------------------------------

            if cx < zone_w:

                zone = "DEFENSE"
                zone_counts["DEFENSE"] += 1

            elif cx < zone_w * 2:

                zone = "MIDFIELD"
                zone_counts["MIDFIELD"] += 1

            else:

                zone = "ATTACK"
                zone_counts["ATTACK"] += 1


            # ------------------------------------------------
            # Store player movement
            # ------------------------------------------------

            final_trails[track_id].append(
                (cx, cy)
            )

            trail_points = list(
                final_trails[track_id]
            )


            # ------------------------------------------------
            # Draw movement trail
            # ------------------------------------------------

            for i in range(1, len(trail_points)):

                cv2.line(
                    annotated,
                    trail_points[i - 1],
                    trail_points[i],
                    (0, 255, 255),
                    3
                )


            # ------------------------------------------------
            # Choose bounding-box color
            # ------------------------------------------------

            if team == "Team A":

                box_color = (0, 0, 255)

            elif team == "Team B":

                box_color = (255, 255, 255)

            else:

                box_color = (0, 255, 0)


            # ------------------------------------------------
            # Draw player bounding box
            # ------------------------------------------------

            cv2.rectangle(
                annotated,
                (x1, y1),
                (x2, y2),
                box_color,
                2
            )


            # ------------------------------------------------
            # Draw ID, team and tactical zone
            # ------------------------------------------------

            label = (
                f"ID:{track_id} | "
                f"{team} | "
                f"{zone}"
            )

            cv2.putText(
                annotated,
                label,
                (x1, max(25, y1 - 5)),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.5,
                box_color,
                2
            )


        # ====================================================
        # 4. DRAW TACTICAL ZONE LINES
        # ====================================================

        cv2.line(
            annotated,
            (zone_w, 0),
            (zone_w, H),
            (255, 255, 0),
            3
        )

        cv2.line(
            annotated,
            (zone_w * 2, 0),
            (zone_w * 2, H),
            (255, 255, 0),
            3
        )


        # ====================================================
        # 5. CROWDING DETECTION
        # ====================================================

        crowded = False

        if len(centers) >= MIN_PLAYERS:

            center_points = np.array(
                centers
            )

            distances = cdist(
                center_points,
                center_points
            )

            nearby_counts = np.sum(
                distances < CROWD_DISTANCE,
                axis=1
            ) - 1

            if np.max(nearby_counts) >= MIN_PLAYERS - 1:

                crowded = True


        # ----------------------------------------------------
        # Count separate crowding events
        # ----------------------------------------------------

        if crowded and not crowd_active:

            total_events += 1
            crowd_active = True

        elif not crowded:

            crowd_active = False


        # ====================================================
        # 6. DASHBOARD BACKGROUND
        # ====================================================

        overlay = annotated.copy()

        cv2.rectangle(
            overlay,
            (20, 20),
            (560, 185),
            (0, 0, 0),
            -1
        )

        annotated = cv2.addWeighted(
            overlay,
            0.70,
            annotated,
            0.30,
            0
        )


        # ====================================================
        # 7. DASHBOARD INFORMATION
        # ====================================================

        cv2.putText(
            annotated,
            "SMART FOOTBALL ANALYTICS",
            (35, 52),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.8,
            (255, 255, 255),
            2
        )

        cv2.putText(
            annotated,
            f"Players: {len(detections_frame)}",
            (35, 82),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.6,
            (255, 255, 255),
            2
        )

        zone_text = (
            f"DEF: {zone_counts['DEFENSE']} | "
            f"MID: {zone_counts['MIDFIELD']} | "
            f"ATT: {zone_counts['ATTACK']}"
        )

        cv2.putText(
            annotated,
            zone_text,
            (35, 112),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.55,
            (255, 255, 255),
            2
        )

        cv2.putText(
            annotated,
            f"Crowding Events: {total_events}",
            (35, 142),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.55,
            (255, 255, 255),
            2
        )


        # ----------------------------------------------------
        # Display tactical status
        # ----------------------------------------------------

        if crowded:

            cv2.putText(
                annotated,
                "TACTICAL ALERT: HIGH CROWDING",
                (35, 172),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.6,
                (0, 0, 255),
                2
            )

        else:

            cv2.putText(
                annotated,
                "STATUS: NORMAL",
                (35, 172),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.6,
                (0, 255, 0),
                2
            )


        # ====================================================
        # 8. WRITE FRAME
        # ====================================================

        sink.write_frame(annotated)


# ============================================================
# FINAL RESULTS
# ============================================================

print("====================================")
print("FINAL VIDEO COMPLETED")
print("====================================")
print("Tracked players:", len(unique_ids))
print("Crowding events:", total_events)
print("Original output:", output_final)


# ------------------------------------------------------------
# Convert and display final video
# ------------------------------------------------------------

convert_and_display(
    output_final,
    final_fixed
)

print("Playable output:", final_fixed)
